{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "DRAFT UNREGISTERED. IDs up to128 characters proposed for asset/voice, others64. No media bytes, licensing or reviewer authority established by schema validity.",
  "title": "Audio Asset v1",
  "description": "Schema for audio assets with provenance and verification information",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "asset_id",
    "voice_id",
    "content_hash",
    "format",
    "sample_rate_hz",
    "channels",
    "duration_seconds",
    "provenance",
    "license_info",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "voice_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,127}$",
      "maxLength": 128
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "format": {
      "type": "string",
      "const": "wav"
    },
    "sample_rate_hz": {
      "type": "integer",
      "minimum": 8000,
      "maximum": 96000
    },
    "channels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 600
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_text_sha256",
        "generator_id",
        "generated_at_utc"
      ],
      "properties": {
        "source_text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "generator_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "generated_at_utc": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
          "format": "date-time"
        }
      }
    },
    "license_info": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence_id"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unknown",
            "evidenced"
          ]
        },
        "evidence_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "evidence_id": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unverified",
            "reviewed",
            "verified"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "reviewed",
              "verified"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reviewer"
        ],
        "properties": {
          "reviewer": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "reviewer": {
            "type": "null"
          }
        }
      }
    }
  }
}
