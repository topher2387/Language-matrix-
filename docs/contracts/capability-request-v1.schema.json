{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:language-matrix:capability-request:1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "capability": {
      "enum": [
        "lesson.generate",
        "phonology.check",
        "tts.synthesize",
        "asr.transcribe",
        "image.generate"
      ]
    },
    "provider": {
      "const": "local"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "language": {
          "const": "ko"
        },
        "voice_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "text",
        "language"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {
          "const": 0
        },
        "allow_network": {
          "const": false
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      },
      "required": [
        "max_cost_usd",
        "allow_network",
        "max_attempts",
        "timeout_seconds"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "output_schema": {
      "enum": [
        "lesson.v1",
        "phonology-report.v1",
        "audio-asset.v1",
        "transcript.v1",
        "image-asset.v1"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "cache.read",
          "cache.write",
          "local.generate"
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "maxItems": 3
    },
    "deadline_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "capability",
    "provider",
    "input",
    "policy",
    "rationale",
    "output_schema",
    "permissions",
    "deadline_utc"
  ]
}
